# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/AqwaValley"

# Logging
LOG_LEVEL="info"

# Ingest and Timescale
TIMESCALE_RETENTION_DAYS="90"
INGEST_RATE_LIMIT_PER_MINUTE="300"

# Cron simulator
# Vercel Cron automatically sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-secret"
SIM_CRON_MAX_WELLS="100"
SIM_CRON_MAX_SENSORS="1000"
SIM_CRON_WELL_CONCURRENCY="8"
SIM_CRON_READING_CHUNK_SIZE="50"
SIM_DEFAULT_ANOMALY_RATE="0.05"
SIM_RUN_STALE_TIMEOUT_SECONDS="900"
SIM_RUN_HISTORY_RETENTION_DAYS="30"

# OpenWeather API
OPENWEATHER_API_KEY="your-openweather-api-key"
