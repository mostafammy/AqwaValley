{
  "name": "AqwaValley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "tsx --tsconfig tsconfig.json scripts/baseline-drizzle-migrations.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "db:timescale:setup": "node ./scripts/setup-timescaledb.mjs",
    "db:timescale:verify": "node ./scripts/verify-timescaledb.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "mock:simulator": "tsx --tsconfig tsconfig.json scripts/mock-simulator.ts",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "cron:sync:qstash": "tsx --tsconfig tsconfig.json scripts/sync-qstash-cron.ts",
    "test": "vitest run src/__tests__",
    "test:watch": "vitest src/__tests__",
    "test:coverage": "vitest run src/__tests__ --coverage",
    "test:e2e": "playwright test",
    "test:irrigation": "tsx scripts/test-irrigation.ts",
    "test:ai": "tsx scripts/test-openrouter.ts",
    "test:replay-diff": "tsx --tsconfig tsconfig.json scripts/test-replay-diff.ts",
    "test:irrigation-api": "tsx --tsconfig tsconfig.json scripts/test-irrigation-trigger-api.ts",
    "test:forecast-integration": "tsx --tsconfig tsconfig.json scripts/test-forecast-integration.ts",
    "test:reporting-integration": "tsx --tsconfig tsconfig.json scripts/test-reporting-integration.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@sentry/nextjs": "^10.46.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@upstash/qstash": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^15.2.3",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.4",
    "openai": "^6.32.0",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "checkly": "latest",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "jiti": "^2",
    "playwright": "^1.58.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
